                    "ImageName": "LeftPanel",
                    "SpriteName": "rina"
                }
            ]
    },
    {
      "Speaker": "ゾフィ",
      "Text": "でも……君と過ごした時間だけは、本物だった。",
      "ChangeImage": [
                {
                    "ImageName": "RightPanel",
                    "SpriteName": "zofy_m"
                }
            ]
