{
  "Content": [
    {
      "Speaker": "ゼバスティアン",
      "Text": "お前は…人間の皮をかぶった魔物だ…。\n　ゾフィ…！",
      "ChangeImage": [
                {
                    "ImageName": "RightPanel",
                    "SpriteName": "zofy"
                },
                {
                    "ImageName": "LeftPanel",
                    "SpriteName": "zebus"
                }
            ]
    },
    {
      "Speaker": "リナ",
      "Text": "……魔物？",
      "ChangeImage": [
                {
                    "ImageName": "LeftPanel",
                    "SpriteName": "rina"
                }
            ]
    },
    {
      "Speaker": "ノア",
      "Text": "ゾフィ…どういうことです？",
      "ChangeImage": [
                {
                    "ImageName": "LeftPanel",
                    "SpriteName": "noa"
                }
            ]
    },
    {
      "Speaker": "ゾフィ",
      "Text": "俺は…魔物だ。\n　人間のふりをして、お前たちと旅をしてきた。\n　でも…心だけは、人間でいたかった。",
      "ChangeImage": [
                {
                    "ImageName": "RightPanel",
                    "SpriteName": "zofy_m"
                }
            ]
    },
    {
      "Speaker": "ノア",
      "Text": "君が魔物でも、僕たちの仲間です。\n　それは変わらない。"
    },
    {
      "Speaker": "ゾフィ",
      "Text": "…ありがとう。\n　俺はずっと、誰かにそう言ってもらえる日を夢見てた。",
      "ChangeImage": [
                {
                    "ImageName": "LeftPanel",
                    "SpriteName": "void"
                },
                {
                    "ImageName": "RightPanel",
                    "SpriteName": "void"
                },
                {
                    "ImageName":"BackgroundPanel",
                    "SpriteName": "odou"
                }
            ]
    },
    {
      "Speaker": "リナ",
      "Text": "さあ、帰ろう。世界は救われた。\n　次は、あんた自身を救う番よ。"
    },
    {
      "Text": "――そして三人は、光差す未来へと歩き出した。"
    }
  ]
}